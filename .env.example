# ==============================================================================
# HERMES LAUNCHPAD - VARIABLES DE ENTORNO (COOLIFY / DOCKER / PRODUCCIÓN)
# ==============================================================================

# --- 1. CREDENCIALES DE ACCESO AL LOGIN ---
# Usuario administrador principal
ADMIN_USERNAME="admin"

# Contraseña del usuario administrador (cámbiala en producción en Coolify)
ADMIN_PASSWORD="admin123"

# Habilitar o deshabilitar el botón de "Modo Demo" en el login (true / false)
# En producción en Coolify ponlo en 'false' para que solo quienes tengan usuario y clave puedan entrar.
ALLOW_DEMO="true"

# Usuarios adicionales opcionales (formato: "usuario:clave,usuario2:clave2")
# ADDITIONAL_USERS="bryant:mypassword123,devops:securepass456"

# --- 2. CONFIGURACIÓN DE BASE DE DATOS SQLITE Y ALMACENAMIENTO ---
# Directorio donde se almacena la base de datos (montado en volumen persistente de Coolify)
DATA_DIR="/app/data"

# Ruta completa al archivo de base de datos SQLite
DATABASE_PATH="/app/data/dashboard.sqlite"

# Cargar datos de prueba al iniciar (true / false)
# Por defecto está en 'false' para que tus tablas de SQLite inicien 100% limpias y vacías para tus programas personales.
SEED_DEMO_DATA="false"

# --- 3. SERVIDOR Y PUERTOS ---
# Puerto del contenedor (Coolify enrutará el tráfico a este puerto)
PORT="3000"

# --- 4. INTELIGENCIA ARTIFICIAL (HERMES AGENT) ---
# Clave de API de Gemini para el agente autónomo Hermes (opcional pero recomendada)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL de la aplicación (inyectada automáticamente en Coolify/Cloud Run o tu dominio)
APP_URL="http://localhost:3000"

